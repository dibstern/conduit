flowchart LR
    browser[Browser SPA
    WS client]
    ws[WsRpcWebSocketHandler
    shared /rpc socket]
    handlers[Message handlers
    src/lib/handlers/*]
    sessions[SessionManager
    and session registry]
    bridges[Permission and
    question bridges]
    projectCore[Project services
    event pipeline, OpenCode SSE
    pollers, PTY wiring]
    eventStore[SQLite event store
    projectors]
    provider[Provider adapter
    stateless execution engine]
    opencode[OpenCode server]

    browser <-->|WebSocket messages| ws
    ws --> handlers
    handlers --> sessions
    handlers --> bridges
    sessions --> projectCore
    bridges --> projectCore
    projectCore -->|Event Delivery| ws
    projectCore --> provider
    provider -->|stream events| eventStore
    provider <-->|REST, SSE, PTY upstream| opencode
    eventStore -->|Event Delivery| ws