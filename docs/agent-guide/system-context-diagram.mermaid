flowchart LR
    cli[CLI
    src/bin/cli.ts
    src/bin/cli-core.ts]
    browser[Browser Clients
    Svelte SPA + WebSocket client]

    subgraph conduitDaemon[conduit daemon]
        daemon[Daemon
        src/lib/daemon/daemon.ts]
        server[Shared HTTP and WS edge
        src/lib/server/*]
        persistence[SQLite event store
        src/lib/persistence/*]
        providers[Provider adapters
        src/lib/provider/*]

        subgraph projects[Project services, opened on first use]
            projectA[Project A services]
            projectB[Project B services]
        end
    end

    opencode[OpenCode server]
    state[Daemon config dir
    socket, config, push settings]

    cli -->|serve or browser RPC control| daemon
    browser -->|HTTP for SPA and APIs| server
    browser <-->|WebSocket messages| server
    daemon --> server
    server --> projectA
    server --> projectB
    projectA --> providers
    projectB --> providers
    providers <-->|REST, SSE, PTY upstream| opencode
    providers -->|stream events| persistence
    persistence --> server
    daemon <--> state
